# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# LLM Provider (supports: deepseek, openai, bedrock). Default is deepseek.
# LLM_PROVIDER=anthropic was removed; use bedrock for Amazon Nova.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-key
# OPENAI_API_KEY=sk-your-openai-key

# Amazon Nova Lite on Amazon Bedrock (set LLM_PROVIDER=bedrock)
# Model: us.amazon.nova-lite-v1:0 in us-east-1.
# Auth uses the standard AWS credential chain (environment variables,
# shared config/credentials files, or an IAM role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# GitHub (optional, for repo cloning)
GITHUB_TOKEN=ghp-your-github-token

# Daytona sandbox (optional — clones GitHub repos in isolated VMs for live scans)
DAYTONA_API_KEY=your-daytona-api-key
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# DAYTONA_DISABLE=1

# App config
PORT=3000
NODE_ENV=development